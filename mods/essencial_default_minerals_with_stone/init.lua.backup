minetest.register_node("essencial_default_minerals_with_stone:stone_with_coal", {
	description = S("Coal Ore"),
	tiles = {"default_stone.png^default_mineral_coal.png"},
	groups = {cracky = 3},
	drop = "essencial_default_minerals_with_stone:coal_lump",
	sound = {},
})

minetest.register_node("essencial_default_minerals_with_stone:coalblock", {
	description = S("Coal Block"),
	tiles = {"default_coal_block.png"},
	is_ground_content = false,
	groups = {cracky = 3},
	sound = {},
})


